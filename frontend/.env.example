# Copy this file to .env and add your Supabase project details.
# Leave both values empty to run the local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Restricted Google Maps browser key for the Discover map and driving routes.
VITE_GOOGLE_MAPS_API_KEY=

# Editable starting suggestion shown to drivers: ₹ per passenger per route kilometre.
# This is not a market quote; drivers set the final fare for each ride.
VITE_VYBE_RATE_PER_KM=12
